@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Целевая архитектура «Будущее 2.0» (через 1 год) — финальная версия

Person(analyst, "Бизнес-аналитик", "Строит отчёты через портал")
Person(doctor, "Врач", "Работает с медицинскими системами")
Person(fintech_user, "Финансовый оператор", "Проводит финансовые операции")
Person(admin, "Администратор безопасности", "Управляет доступом и политиками")
Person(data_steward, "Дата-стюард", "Размечает и описывает данные")

System_Boundary(cloud, "Облачная платформа") {
    
    Container(iam, "IAM-сервис", "Identity Provider", "Единая аутентификация, RBAC, аудит доступа ко всем системам")
    Container(api_gateway, "API Gateway", "Cloud Gateway", "Единая точка входа, маршрутизация, rate limiting, TLS")
    
    Container(data_portal, "Портал самообслуживания", "Web + API", "Конструктор отчётов, метаданные, контроль доступа на уровне ролей")
    Container(data_catalog, "Data Catalog", "Metadata UI + Search", "Поиск, описание и разметка данных, бизнес-глоссарий")
    Container(metadata_svc, "Сервис управления метаданными", "Apache Atlas-like", "Линидж данных, классификация, политики, аудит изменений")
    
    Container(analytics_core, "Аналитическое ядро", "Lakehouse + BI Engine", "Агрегированные обезличенные данные для быстрых отчётов")
    Container(message_broker, "Брокер сообщений", "Kafka/RabbitMQ", "Асинхронный обмен событиями между доменами, буферизация, гарантированная доставка")
    
    Container_Boundary(medical_domain, "Домен: Медицина") {
        Container(med_db, "Медицинская БД", "Cloud SQL/NoSQL", "Карты пациентов, снимки, результаты исследований")
        Container(med_svc, "Медицинские сервисы", "Microservices", "CRUD операции, валидация, бизнес-логика домена")
        Container(sensitive_svc, "Сервис работы с чувствительными данными", "Encryption/Tokenization", "Маскирование, псевдонимизация, контроль доступа к ПДн")
    }
    
    Container_Boundary(fintech_domain, "Домен: Финтех") {
        Container(ft_db, "Финансовая БД", "Cloud OLAP", "Счета, транзакции, кредиты, финансовая история")
        Container(ft_svc, "Финтех-сервисы", "Go/Java", "Платежи, скоринг, финансовая отчётность")
    }
    
    Container_Boundary(ai_domain, "Домен: ИИ") {
        Container(ai_svc, "ИИ-модели", "Python/ML Platform", "Диагностика, прогнозы, анализ медицинских данных")
    }
    
    Container_Boundary(legacy_layer, "Слой интеграции с легаси") {
        Container(legacy_adapter, "Адаптер DWH", "ETL/ELT + API Wrapper", "Изолирует старое хранилище, предоставляет стандартизированный интерфейс")
        Container(legacy_dwh, "Legacy DWH", "SQL Server 2008", "Исторические данные, часть бизнес-логики, постепенно выводится")
    }
    
    Container(backup_dr, "Сервис резервного копирования и DR", "Cloud Backup + Geo-Replication", "Автоматические бэкапы, восстановление, геораспределённая отказоустойчивость")
}

' Внешние пользователи к системам
Rel(analyst, data_portal, "Строит отчёты", "HTTPS")
Rel(doctor, med_svc, "Работает с картами", "HTTPS")
Rel(fintech_user, ft_svc, "Проводит операции", "HTTPS")
Rel(admin, iam, "Управляет ролями", "Admin UI")
Rel(data_steward, data_catalog, "Размечает данные", "UI")
Rel(data_steward, metadata_svc, "Настраивает политики", "Admin API")

' IAM ко всем системам
Rel(iam, data_portal, "Проверяет права", "OIDC/OAuth2")
Rel(iam, med_svc, "Проверяет права", "OIDC/OAuth2")
Rel(iam, ft_svc, "Проверяет права", "OIDC/OAuth2")
Rel(iam, ai_svc, "Проверяет права", "OIDC/OAuth2")
Rel(iam, data_catalog, "Проверяет права", "OIDC/OAuth2")
Rel(api_gateway, iam, "Валидация токенов", "OIDC/OAuth2")

' API Gateway как единая точка входа
Rel(api_gateway, data_portal, "Маршрутизирует запросы", "HTTPS")
Rel(api_gateway, med_svc, "Маршрутизирует запросы", "HTTPS")
Rel(api_gateway, ft_svc, "Маршрутизирует запросы", "HTTPS")
Rel(api_gateway, ai_svc, "Маршрутизирует запросы", "HTTPS")

' Портал к аналитике и каталогу
Rel(data_portal, analytics_core, "Запрашивает агрегаты", "Internal API")
Rel(data_portal, data_catalog, "Ищет данные", "Search API")
Rel(data_catalog, metadata_svc, "Получает метаданные и линидж", "Internal API")

' Аналитическое ядро к источникам
Rel(analytics_core, message_broker, "Получает события", "Subscribe")
Rel(analytics_core, legacy_adapter, "Выгружает исторические данные", "Batch ETL")
Rel(analytics_core, metadata_svc, "Отправляет метаданные", "Hook/API")

' Домены к брокеру сообщений
Rel(sensitive_svc, message_broker, "Публикует обезличенные события", "Publish")
Rel(ft_svc, message_broker, "Публикует финансовые события", "Publish")
Rel(ai_svc, message_broker, "Публикует результаты моделей", "Publish")

' Домены к метаданным
Rel(med_svc, metadata_svc, "Регистрирует схему данных", "Metadata API")
Rel(ft_svc, metadata_svc, "Регистрирует схему данных", "Metadata API")
Rel(ai_svc, metadata_svc, "Регистрирует модели и метрики", "Metadata API")

' Медицина к сервису чувствительных данных
Rel(med_svc, sensitive_svc, "Передаёт данные для защиты", "Internal API")

' Легаси слой
Rel(legacy_adapter, legacy_dwh, "Обращается к легаси", "Legacy Protocol")
Rel(legacy_adapter, metadata_svc, "Экстрагирует метаданные легаси", "Scanner")

' Резервное копирование
Rel(backup_dr, legacy_dwh, "Резервное копирование", "Backup Agent")
Rel(backup_dr, med_db, "Резервное копирование", "Snapshot")
Rel(backup_dr, ft_db, "Резервное копирование", "Snapshot")
Rel(backup_dr, analytics_core, "Резервное копирование", "Snapshot")

' Примечания
Note right of data_portal: **Витрина данных**\nТолько обезличенные агрегаты\nМедицинские карты — вне периметра
Note right of metadata_svc: **Data Governance**\nЛинидж, классификация, политики\nАвтоматическое отслеживание происхождения
Note right of legacy_layer: **Стратегия миграции**\nЛегаси изолирован, новые функции — в доменах\nПостепенный вывод DWH из эксплуатации
Note right of backup_dr: **Надёжность**\nRPO < 15 мин, RTO < 1 час\nдля критичных систем
Note right of message_broker: **Асинхронная интеграция**\nДомены независимы\nСбой в одном не блокирует остальные
Note right of iam: **Единый доступ**\nRBAC, аудит, комплаенс\nдля медицины и финтеха

@enduml